<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_row" />
            <solid android:color="@color/surface_focused" />
            <stroke android:width="2.5dp" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_row" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/surface_stroke" />
        </shape>
    </item>
</selector>
