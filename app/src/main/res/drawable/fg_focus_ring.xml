<?xml version="1.0" encoding="utf-8"?>
<!--
  焦点环画在 foreground：海报图铺满整张卡片，background 会被图盖住看不见。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/surface_stroke" />
        </shape>
    </item>
</selector>
