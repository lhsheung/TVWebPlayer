<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focused" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
            <corners android:radius="10dp" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/surface_stroke" />
            <corners android:radius="10dp" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
