<?xml version="1.0" encoding="utf-8"?>
<!--
  ext 模块入口页：粤漫之家 / 播放列表 / 本地视频 / 局域网传片 / 收藏夹
  视觉沿用 blbl 的主题 token（?attr/blbl*），保证与主界面同一套观感。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop"
    android:clipToPadding="false"
    android:focusable="true"
    android:paddingStart="@dimen/settings_content_padding_h"
    android:paddingTop="32dp"
    android:paddingEnd="@dimen/settings_content_padding_h"
    android:paddingBottom="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ext_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="扩展功能"
            android:textColor="?attr/colorOnSurface"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ext_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="粤漫之家站点、本地/远程播放列表、局域网传片"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_ext_entries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
