<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <TextView
        android:id="@+id/plTitle"
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="44dp"
        android:text="播放列表"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/plSub"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="6dp"
        android:text="支持 M3U8 / M3U / DPL · 长按列表名可删除"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/plTitle" />

    <TextView
        android:id="@+id/btnImportUrl"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="42dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_chip"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:text="从网址导入"
        android:textColor="@color/chip_text"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/btnImportFile"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnImportFile"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="42dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_chip"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:text="从文件导入"
        android:textColor="@color/chip_text"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 网格：每行 4 个，播放入口平铺，不用一路按右键 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/plGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="26dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/plSub" />

    <TextView
        android:id="@+id/plEmpty"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        android:gravity="center"
        android:text="还没有播放列表\n\n点右上角「从网址导入」或「从文件导入」"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/plGrid"
        app:layout_constraintEnd_toEndOf="@id/plGrid"
        app:layout_constraintStart_toStartOf="@id/plGrid"
        app:layout_constraintTop_toTopOf="@id/plGrid" />

</androidx.constraintlayout.widget.ConstraintLayout>
