<?xml version="1.0" encoding="utf-8"?>
<!--
  局域网传输页：左二维码 + 地址，右状态 / 遥控器按钮 / 实时日志。
  QR 用 weight 撑满剩余高度，避免不同 density 的盒子出现方形被裁切。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:paddingStart="56dp"
    android:paddingTop="40dp"
    android:paddingEnd="56dp"
    android:paddingBottom="32dp">

    <!-- 左：二维码 + 地址 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.40"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="用手机扫描二维码打开上传页"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="-0.015" />

        <TextView
            android:id="@+id/tvHint"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="手机相机 / 微信扫一扫，或在浏览器输入上面的地址" />
    </LinearLayout>

    <Space
        android:layout_width="40dp"
        android:layout_height="match_parent" />

    <!-- 右：说明 + 遥控器按钮 + 日志 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.60"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="局域网传输" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="手机与电视连同一个 WiFi。传播放列表文件（M3U / M3U8 / DPL / TXT），或把站点链接、播放列表链接、视频直链发到电视上。" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="服务启动中…"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_toolbar_btn"
                android:focusable="true"
                android:text="换一个地址"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_toolbar_btn"
                android:focusable="true"
                android:text="停止服务并返回"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="接收记录" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@color/bg_elevated"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="14dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:text="等待手机发送…"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </ScrollView>

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="服务仅在此页打开时运行，退出即关闭端口。同一局域网内任何设备都能访问，请勿在公共 WiFi 使用。" />
    </LinearLayout>
</LinearLayout>
